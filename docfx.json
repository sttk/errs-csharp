{
  "metadata": [
    {
      "src": [
        {
          "files": ["Errs/Errs.csproj"]
        }
      ],
      "dest": "_site/api_yml"
    }
  ],
  "build": {
    "content": [
      {
        "files": ["**/*.yml"],
        "src": "_site/api_yml",
        "dest": "api"
      },
      {
        "files": ["**/*.md", "toc.yml"],
        "exclude": ["obj/**", "_site/api/**"]
      }
    ],
    "resource": [
      {
        "files": "**/images/**",
      }
    ],
    "output": "_site"
  }
}
